{
  "name": "web-search-agent",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "dev": "tsx src/server.ts",
    "web": "tsx src/server.ts",
    "chat": "tsx src/agent.ts",
    "start": "tsx src/agent.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test",
    "db:check": "tsx scripts/db-check.ts",
    "db:reset": "rm -f data/*.db data/*.db-wal data/*.db-shm",
    "eval": "tsx eval/cli.ts",
    "eval:live": "tsx eval/cli.ts --live"
  },
  "dependencies": {
    "better-sqlite3": "^13.2.0",
    "openai": "^7.57.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
