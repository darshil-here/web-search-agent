# Required. The only two API keys the agent uses.
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Tavily: https://app.tavily.com/home
TAVILY_API_KEY=

# Required.
# gpt-6-luna by default; use any model your account can access.
MODEL=gpt-6-luna

# Optional. Not secrets.
# The timezone "today", "yesterday" and "last Tuesday" resolve in.
USER_TZ=Asia/Kolkata
# Which conversation the CLI and web UI open by default.
SESSION_ID=local
# Web port. The server binds to 127.0.0.1 only.
# PORT=3000
# Where SQLite and traces are written. Both are gitignored.
# DB_PATH=data/agent.db
# TRACES_DIR=traces
# Bounds. Defaults shown.
# MAX_STEPS=5
# MAX_RECHECK_SEARCHES=12
# MAX_PAGE_FETCHES=6
